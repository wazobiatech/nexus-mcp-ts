{
  "name": "@wazobiatech/nexus-mcp",
  "version": "1.0.0",
  "description": "TypeScript SDK for Nexus MCP — HMAC middleware, server factory, and manifest generation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware/hmac.middleware.d.ts",
        "default": "./dist/middleware/hmac.middleware.js"
      },
      "require": {
        "types": "./dist/middleware/hmac.middleware.d.ts",
        "default": "./dist/middleware/hmac.middleware.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/createMCPServer.d.ts",
        "default": "./dist/server/createMCPServer.js"
      },
      "require": {
        "types": "./dist/server/createMCPServer.d.ts",
        "default": "./dist/server/createMCPServer.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "generate-manifest": "dist/cli/generate-manifest.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage --verbose",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "nexus",
    "wazobia",
    "model-context-protocol"
  ],
  "author": "Wazobia Tech",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "ajv": "^8.14.0",
    "express": "^4.19.2",
    "glob": "^10.4.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  }
}
